# SerpBear Environment Configuration
# Copy this file to .env.local for development or .env for production

# Authentication & Security
USER=admin
PASSWORD=0123456789
# Generate SECRET and APIKEY with: openssl rand -hex 32
SECRET=replace-with-a-long-random-string
APIKEY=replace-with-a-long-random-string
SESSION_DURATION=24
# Number of reverse proxies in front of the app (0 = none). Login lockouts and rate limits then use the
# X-Forwarded-For entry that many hops from the right instead of the proxy's own address.
# TRUST_PROXY=0

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCREENSHOTS=true

# White-label Branding
NEXT_PUBLIC_WHITE_LABEL=false
# File name (stored in /app/data) for the custom logo. Recommended dimensions: 96x96 pixels.
WHITE_LABEL_LOGO_FILE=branding-logo.png
NEXT_PUBLIC_PLATFORM_NAME=SerpBear

# Cron Job Configuration
CRON_TIMEZONE=America/New_York
CRON_MAIN_SCHEDULE=0 0 0 * * *
CRON_FAILED_SCHEDULE=0 0 */1 * * *
CRON_EMAIL_SCHEDULE=0 0 6 * * *

# Refresh Queue Configuration
# Maximum number of domains that can be refreshed in parallel (default: 3)
# Increase for better throughput on powerful hardware, decrease to reduce load
# REFRESH_QUEUE_CONCURRENCY=3

# Maximum simultaneous keyword scrapes per domain for sequential scraper providers (default: 3)
# PARALLEL_SCRAPE_CONCURRENCY=3

# Google Search Console (Optional)
# SEARCH_CONSOLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Monitoring & Logging (Optional)
# LOG_LEVEL options:
#   - none: Disables all logging
#   - info: High-level operational messages, key actions, success/failure states (default)
#   - error: Detailed error information with context for troubleshooting
#   - debug: Full diagnostic output including API requests, responses, and internal processing
# LOG_LEVEL=info

# Docker Logging Notes:
# All logs are output to stdout in JSON format and captured by Docker.
# View logs with: docker logs <container-name>
# Or follow logs with: docker logs -f <container-name>
