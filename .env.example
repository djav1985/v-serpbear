# SerpBear Environment Configuration
# Copy this file to .env.local for development or .env for production

# Authentication & Security
# The placeholder values below MUST be changed before use. Never commit real values to version control.
USER=admin
# Optional override of USER (some shells set USER automatically). When set, USER_NAME is used as the login name.
# USER_NAME=admin
PASSWORD=change-me
# Generate SECRET and APIKEY with: openssl rand -hex 32
SECRET=replace-with-a-long-random-string
APIKEY=replace-with-a-random-api-key
SESSION_DURATION=24
# Number of reverse proxies in front of the app (0 = none). Login lockouts and rate limits then use the
# X-Forwarded-For entry that many hops from the right instead of the proxy's own address.
# TRUST_PROXY=0

# Application Settings
# Public URL of your deployment. Used for OAuth callbacks and links in email digests.
# docker-compose.yml passes this through from .env (default http://localhost:3000), so set your real URL here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side origin the cron worker uses to call the app. When set it takes precedence over NEXT_PUBLIC_APP_URL,
# which is useful when the public URL is not reachable from inside the container. Leave unset to use NEXT_PUBLIC_APP_URL.
# docker-compose.yml passes this through from .env (empty by default).
# APP_URL=http://localhost:3000
# Keyword thumbnail capture via thum.io. Read by the server at request time (/api/branding/config),
# so changing it does not require a rebuild. Set to false to show favicons instead.
SCREENSHOTS=true

# White-label Branding
NEXT_PUBLIC_WHITE_LABEL=false
# File name (stored in /app/data) for the custom logo. Recommended dimensions: 96x96 pixels.
WHITE_LABEL_LOGO_FILE=branding-logo.png
NEXT_PUBLIC_PLATFORM_NAME=SerpBear

# Cron Job Configuration
# IANA time zone name (for example America/New_York, Europe/London, Pacific/Auckland). It controls:
#   - When the cron jobs fire (CRON_MAIN_SCHEDULE, CRON_FAILED_SCHEDULE, CRON_EMAIL_SCHEDULE).
#   - What "today" means in results, daily emails, email throttling, and the UI.
#   - The calendar day used for history keys: each history entry is keyed by the calendar date in this zone.
# Instants are still stored in UTC. An unknown name falls back to America/New_York.
# Changing it later does not re-key existing history entries, so old entries keep their old dates.
TZ=America/New_York
# Time of day (HH:MM, 24 hour) of the scrapes and the Search Console refresh. The scrape interval picks the days.
CRON_MAIN_SCHEDULE=00:00
# Retry of failed scrapes: hourly, daily (at the CRON_MAIN_SCHEDULE time) or never.
CRON_FAILED_SCHEDULE=hourly
# Time of day (HH:MM, 24 hour) of the email digests. The notification interval picks the days.
CRON_EMAIL_SCHEDULE=06:00

# Refresh Queue Configuration
# Maximum number of domains that can be refreshed in parallel (default: 3)
# Increase for better throughput on powerful hardware, decrease to reduce load
# REFRESH_QUEUE_CONCURRENCY=3

# Maximum number of keywords scraped in parallel within a single refresh run (default: 10, must be a positive integer)
# PARALLEL_REFRESH_CONCURRENCY=10

# Maximum simultaneous keyword scrapes per domain for sequential scraper providers (default: 3)
# PARALLEL_SCRAPE_CONCURRENCY=3

# Serper API key (Optional). Google returns some result links as google.com/goto redirects; with a key, they are
# turned into real URLs through Serper's free /resolve endpoint (it can add up to a minute to a scrape). Get a key at serper.dev.
# SERPER_API_KEY=

# Google Search Console (Optional)
# SEARCH_CONSOLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Monitoring & Logging (Optional)
# LOG_LEVEL options:
#   - none: Disables all logging
#   - warn: Warnings and errors only
#   - info: High-level operational messages, key actions, success/failure states (default)
#   - error: Detailed error information with context for troubleshooting
#   - debug: Full diagnostic output including API requests, responses, and internal processing
# LOG_LEVEL=info

# Docker Logging Notes:
# All logs are output to stdout in JSON format and captured by Docker.
# View logs with: docker logs <container-name>
# Or follow logs with: docker logs -f <container-name>
